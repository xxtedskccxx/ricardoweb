# Public site URL (used for metadata, canonical URLs, sitemap).
NEXT_PUBLIC_SITE_URL=

# Neon — create a free Postgres project at https://neon.tech.
DATABASE_URL=
# At least 32 random characters. PowerShell/Node: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Cloudinary — cloud name is public; key/secret are server-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=altamar/dev

# Owner contact — centralized here, never hard-coded in components.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
